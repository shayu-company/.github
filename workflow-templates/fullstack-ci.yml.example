name: CI
# Reusable validation workflow. Copy this file alongside fullstack-deploy.yml.
on:
  pull_request:
    branches: [main, staging]
  workflow_call:
    inputs:
      component:
        type: string
        default: auto
    outputs:
      frontend:
        value: ${{ jobs.detect-changes.outputs.frontend }}
      backend:
        value: ${{ jobs.detect-changes.outputs.backend }}
permissions:
  contents: read
jobs:
  detect-changes:
    name: Detect changes
    runs-on: ubuntu-latest
    outputs:
      frontend: ${{ steps.detect.outputs.frontend }}
      backend: ${{ steps.detect.outputs.backend }}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - id: detect
        shell: bash
        env:
          COMPONENT: ${{ inputs.component }}
          EVENT: ${{ github.event_name }}
          BEFORE: ${{ github.event.before }}
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
        run: |
          set -euo pipefail
          if [[ "$COMPONENT" == "fullstack" ]]; then
            FRONTEND=true; BACKEND=true
          elif [[ "$COMPONENT" == "frontend" ]]; then
            FRONTEND=true; BACKEND=false
          elif [[ "$COMPONENT" == "backend" ]]; then
            FRONTEND=false; BACKEND=true
          else
            if [[ "$EVENT" == "pull_request" ]]; then
              FILES="$(git diff --name-only "$BASE_SHA" "$GITHUB_SHA")"
            elif [[ -n "$BEFORE" && ! "$BEFORE" =~ ^0+$ ]] && git cat-file -e "$BEFORE^{commit}" 2>/dev/null; then
              FILES="$(git diff --name-only "$BEFORE" "$GITHUB_SHA")"
            else
              FILES="$(git ls-files)"
            fi
            FRONTEND=false; BACKEND=false
            if grep -Eq '^(frontend/|shared/|\.github/workflows/)' <<< "$FILES"; then FRONTEND=true; fi
            if grep -Eq '^(backend/|shared/|\.github/workflows/)' <<< "$FILES"; then BACKEND=true; fi
          fi
          echo "frontend=$FRONTEND" >> "$GITHUB_OUTPUT"
          echo "backend=$BACKEND" >> "$GITHUB_OUTPUT"
          echo "Frontend: $FRONTEND | Backend: $BACKEND" >> "$GITHUB_STEP_SUMMARY"
  ci-frontend:
    name: CI Frontend
    needs: detect-changes
    if: needs.detect-changes.outputs.frontend == 'true'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '24'
          cache: npm
          cache-dependency-path: frontend/package-lock.json
      - working-directory: frontend
        run: |
          npm ci
          npm run check
          npm run format:check
          npm test
          npm run build
          npm run smoke:build
      - uses: actions/upload-artifact@v4
        with:
          name: frontend-dist
          path: frontend/dist/
          if-no-files-found: error
  ci-backend:
    name: CI Backend
    needs: detect-changes
    if: needs.detect-changes.outputs.backend == 'true'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '24'
          cache: npm
          cache-dependency-path: backend/package-lock.json
      - working-directory: backend
        run: |
          npm ci
          npm test
